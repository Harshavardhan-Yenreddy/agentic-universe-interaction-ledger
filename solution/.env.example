# 32-byte hexadecimal AES key for AES-256-GCM authenticated encryption (64 hex characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LEDGER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret salt / pepper for HMAC-SHA256 blind phone indexing (64 hex characters recommended)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LEDGER_HMAC_SALT=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Optional: Path to SQLite database file (defaults to solution/ledger.db)
LEDGER_DB_PATH=solution/ledger.db

